NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Comma-separated Supabase Auth user UUIDs. No account is an admin when empty.
ADMIN_USER_IDS=

# Set to the final public origin (no path), e.g. https://www.example.com.
# SEO indexing and the sitemap stay disabled until this is configured.
SITE_URL=
